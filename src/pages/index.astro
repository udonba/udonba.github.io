---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const hero = await getEntry("pages", "home");
const sections = await getEntry("pages", "home-sections");

if (!hero) {
  throw new Error("Missing home page content: src/content/pages/home.md");
}

if (!sections) {
  throw new Error(
    "Missing home sections content: src/content/pages/home-sections.md"
  );
}

const { Content: HeroContent } = await render(hero);
const { Content: SectionsContent } = await render(sections);
---

<Layout title={hero.data.title} description={hero.data.description}>
  <Header />
  <main id="main-content" class="app-layout">
    <section
      id="hero"
      class="border-border grid gap-6 border-b pt-8 pb-8 sm:grid-cols-[8rem_1fr] sm:items-center"
    >
      <img
        src={hero.data.avatar}
        alt=""
        width="128"
        height="128"
        class="border-border bg-muted size-28 rounded-full border object-cover sm:size-32"
        loading="eager"
      />
      <div>
        <h1 class="my-3 text-4xl font-bold sm:text-5xl">{hero.data.title}</h1>
        <p class="text-muted-foreground text-xl">{hero.data.headline}</p>
        <div class="app-prose mt-4">
          <HeroContent />
        </div>
      </div>
    </section>

    <section class="app-prose py-10">
      <SectionsContent />
    </section>
  </main>
  <Footer />
</Layout>
